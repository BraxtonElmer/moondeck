{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moondeck",
  "version": "0.1.0",
  "identifier": "dev.braxtonelmer.moondeck",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Moondeck",
        "url": "index.html",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/icon.png", "icons/icon.ico"]
  }
}
